# Copy to .env for local development. Never commit the real .env.
# In production these are set in the Render dashboard, not in a file.

# AI (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
# Optional: override the models. Groq retires models, so keep these configurable.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Database. Local default is SQLite if this is unset.
# Postgres format: no quotes, no "psql" prefix, ending with sslmode=require for Neon
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk (backend verifies tokens; the secret key stays on the server only)
CLERK_ISSUER=https://clerk.your-domain.com
CLERK_SECRET_KEY=sk_test_or_sk_live_xxx
# Origins allowed to obtain tokens for this API (comma-separated, exact origins)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# CORS: exact origins allowed to call the API (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173
